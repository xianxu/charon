# Repo-specific Makefile targets.
# This file is included by Makefile — add your own targets here.

.PHONY: build sign test run clean signing-identity install \
        security-build security-install security security-remedy security-uninstall

# ── Codesigning configuration ────────────────────────────────────────────────
# These two values must stay in sync with charonCodesignIdentifier in
# internal/vault/keychain/codesign_darwin.go. The runtime self-check uses
# the identifier; the keychain ACL pins to the leaf cert hash that gets
# embedded by codesign.
SIGN_IDENTITY       ?= Charon Self-Signed
CODESIGN_IDENTIFIER ?= com.charon.cli

build:
	go build -o bin/charon ./cmd/charon

test:
	go test ./...

run: build
	./bin/charon serve

test-integration:
	go test -tags integration ./...

# Sign the locally-built binary in place. Standalone target so you can
# inspect the signature (`codesign -dv`) before installing.
#
# Requires that `make signing-identity` has been run once. Errors out
# (with a hint) otherwise.
sign: build
	@if ! security find-identity ~/Library/Keychains/login.keychain-db 2>/dev/null | grep -q '"$(SIGN_IDENTITY)"'; then \
		echo "Error: '$(SIGN_IDENTITY)' identity not found in login keychain." ; \
		echo "Run 'make signing-identity' first to bootstrap a self-signed identity." ; \
		exit 1 ; \
	fi
	codesign --force --sign "$(SIGN_IDENTITY)" --identifier "$(CODESIGN_IDENTIFIER)" bin/charon
	codesign --verify --verbose=1 bin/charon

install: sign
	@mkdir -p ~/.local/bin
	@rm -f ~/.local/bin/charon
	@cp bin/charon ~/.local/bin/charon
	@echo "Installed signed charon to ~/.local/bin/charon"
	@case ":$$PATH:" in \
		*":$$HOME/.local/bin:"*) ;; \
		*) echo "" ; \
		   echo "~/.local/bin is not in your PATH. Add it with:" ; \
		   echo '  export PATH="$$HOME/.local/bin:$$PATH"' ; \
		   echo "" ; \
		   echo "To make it permanent, add that line to your ~/.zshrc or ~/.bashrc" ;; \
	esac

clean:
	rm -rf bin/

# Bootstrap a self-signed code-signing identity (macOS).
# Idempotent. See scripts/dev/setup-signing-identity.sh for what this does.
signing-identity:
	@scripts/dev/setup-signing-identity.sh

# ── Security audit tool ──────────────────────────────────────────────────────
# `charon-security` is packaged as a .app bundle so TCC attributes
# permissions to com.charon.security specifically. See
# workshop/issues/000010-security-audit-tool.md and
# scripts/dev/build-security-app.sh for the rationale.

SECURITY_BUNDLE_ID    ?= com.charon.security
SECURITY_APP_NAME     ?= Charon Security
SECURITY_APP_DIR      ?= $(HOME)/Applications/$(SECURITY_APP_NAME).app
SECURITY_BUNDLE_STAMP := bin/.security-bundle.stamp

# Track Go sources affecting charon-security so Make rebuilds the
# binary only when something it cares about changed. Ran at makefile
# parse time — cheap (~30 files).
SEC_GO_SOURCES := $(shell find cmd/charon-security internal/security -name '*.go' 2>/dev/null)

bin/charon-security: $(SEC_GO_SOURCES)
	go build -o $@ ./cmd/charon-security

# Stamp file lives under bin/ (no spaces in path; the .app dir does
# have a space which Make handles poorly). Touched after a successful
# install. The codesign step inside the script is the expensive bit
# (Allow/Deny keychain prompt), so we want to run it only when the
# binary actually changed — Make's natural dep tracking on the stamp
# delivers that.
$(SECURITY_BUNDLE_STAMP): bin/charon-security scripts/dev/build-security-app.sh
	@BUNDLE_ID="$(SECURITY_BUNDLE_ID)" \
	 APP_NAME="$(SECURITY_APP_NAME)" \
	 APP_DIR="$(SECURITY_APP_DIR)" \
	 SIGN_IDENTITY="$(SIGN_IDENTITY)" \
	 BINARY=bin/charon-security \
	 scripts/dev/build-security-app.sh
	@touch $@

security-build: bin/charon-security
	@:

security-install: $(SECURITY_BUNDLE_STAMP)
	@:

# Run the audit. Bundle is rebuilt + re-signed iff source changed
# since last install, so steady-state `make security` runs trigger
# zero codesign prompts.
security: $(SECURITY_BUNDLE_STAMP)
	@"$(SECURITY_APP_DIR)/Contents/MacOS/charon-security" check

# Print the remediation playbook (no privileged access required, so
# we don't need to route through the .app bundle).
security-remedy: bin/charon-security
	@bin/charon-security remedy

security-uninstall:
	@if [ -d "$(SECURITY_APP_DIR)" ]; then \
		rm -rf "$(SECURITY_APP_DIR)" ; \
		echo "Removed $(SECURITY_APP_DIR)" ; \
	fi
	@rm -f $(SECURITY_BUNDLE_STAMP)
	@tccutil reset SystemPolicyAllFiles "$(SECURITY_BUNDLE_ID)" 2>/dev/null || true
	@tccutil reset Accessibility       "$(SECURITY_BUNDLE_ID)" 2>/dev/null || true
	@tccutil reset ScreenCapture       "$(SECURITY_BUNDLE_ID)" 2>/dev/null || true
	@tccutil reset AppleEvents         "$(SECURITY_BUNDLE_ID)" 2>/dev/null || true
	@echo "Cleaned any TCC grants for $(SECURITY_BUNDLE_ID)."
